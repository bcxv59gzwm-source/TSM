# Base URL of the UniFi OS console (UDM, UDM-Pro, UDR, Cloud Gateway, or
# self-hosted controller reachable through a UniFi OS proxy).
UNIFI_HOST=https://192.168.1.1

# API key generated in the UniFi OS UI:
# Settings > Control Plane > Integrations > Create API Key
UNIFI_API_KEY=

# Optional: default site short name used when a tool call omits `site`.
# Leave unset to default to "default".
UNIFI_DEFAULT_SITE=default

# Optional: set to "true" to accept the controller's self-signed
# certificate. Only do this on a trusted local network.
UNIFI_ALLOW_INSECURE_TLS=true
